# Which realtime provider to use: azure (default) or openai
REALTIME_PROVIDER=azure

# Azure OpenAI (GA realtime endpoint: wss://<resource>.openai.azure.com/openai/v1/realtime?model=<deployment>)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime

# OpenAI fallback (used when REALTIME_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Voice + transcription
REALTIME_VOICE=ash
REALTIME_SPEED=1.15
TRANSCRIBE_MODEL=gpt-4o-transcribe
# semantic_vad eagerness: auto | low | medium | high (lower = fewer self-interruptions on speakers)
VAD_EAGERNESS=auto

# multi = Presenter + Deck Expert with handoffs; single = one merged agent (lower latency)
AGENT_MODE=multi
# Cut the agent off when it states a figure that is not in the deck
GROUNDING_GUARDRAIL=true

# Comma-separated origins allowed to open the /ws socket (empty = allow any)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
